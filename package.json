{
  "name": "lm-superapp",
  "version": "0.2.0",
  "description": "LM SuperApp - a desktop home for small language models",
  "main": "out/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.web.json && esbuild src/renderer/app.ts --bundle --format=iife --sourcemap --target=es2022 --loader:.svg=text --outfile=src/renderer/app.js",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder"
  },
  "license": "MIT",
  "author": "Sqersters",
  "devDependencies": {
    "@types/node": "26.6.3",
    "electron": "44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "katex": "0.16.22"
  },
  "build": {
    "appId": "com.sqersters.lmsuperapp",
    "productName": "LM SuperApp",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "src/renderer/**/*",
      "src/backend/**/*",
      "docs/CHANGELOG.md",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "LM SuperApp"
    }
  }
}
